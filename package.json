{
  "name": "prumo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm --filter \"./packages/*\" --filter ./catalog --workspace-concurrency=1 run typecheck",
    "lint": "eslint packages catalog",
    "test": "pnpm --filter \"./packages/*\" --filter ./catalog --workspace-concurrency=1 run test",
    "verify:packages": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:reference": "pnpm --filter @matizze/prumo-reference run verify",
    "verify:starter": "pnpm --filter @matizze/prumo-starter run verify",
    "verify": "pnpm verify:packages && pnpm verify:reference && pnpm verify:starter",
    "starter:build": "pnpm --filter @matizze/prumo-starter run starter:build",
    "verify:generated": "scripts/verify-generated.sh",
    "verify:product": "scripts/verify-product.sh",
    "dev": "pnpm --filter @matizze/prumo-reference run dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "pack:all": "scripts/pack-packages.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
