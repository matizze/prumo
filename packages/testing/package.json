{
  "name": "@matizze/prumo-testing",
  "version": "0.4.0",
  "description": "Utilitários de teste do Prumo, sem interface: renderWithProviders com rota em memória, setup do DOM, matchMedia controlável, createDeferred e o teste de contrato de um use case.",
  "keywords": [
    "react",
    "testing",
    "vitest",
    "testing-library",
    "jsdom",
    "typescript",
    "prumo"
  ],
  "homepage": "https://docs.prumo.matizze.com.br",
  "bugs": {
    "url": "https://github.com/matizze/prumo/issues"
  },
  "license": "MIT",
  "author": "Matizze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matizze/prumo.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./dom": "./src/dom/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contract": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "./dom": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react": "^16.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.1.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wouter": "^3.13.0"
  },
  "engines": {
    "node": ">=24"
  }
}
