{
  "name": "@matizze/prumo-core",
  "version": "0.1.0",
  "description": "Infraestrutura comum dos produtos do Prumo: container de repositórios, query keys, tipo Page, utilitários de mock, i18n, erros com código, guarda de login e provedor de query.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors/index.ts",
    "./data": "./src/data/index.ts",
    "./mock": "./src/mock/index.ts",
    "./query": "./src/query/index.ts",
    "./auth": "./src/auth/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./errors": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "default": "./dist/data/index.js"
      },
      "./mock": {
        "types": "./dist/mock/index.d.ts",
        "default": "./dist/mock/index.js"
      },
      "./query": {
        "types": "./dist/query/index.d.ts",
        "default": "./dist/query/index.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "./repositories": {
        "types": "./dist/repositories/index.d.ts",
        "default": "./dist/repositories/index.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-icu": "^2.5.0",
    "react": "^19.3.1",
    "react-i18next": "^17.0.15",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-icu": "^2.5.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  }
}
