{
  // Emite dist/ (.js e .d.ts) para a publicação. O tsconfig.json do pacote só confere os tipos.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // Os imports internos terminam em .ts (o workspace roda o código-fonte): no dist viram .js
    "rewriteRelativeImportExtensions": true
  },
  // Fora do pacote publicado: os testes, os arquivos de apoio deles e os projetos de fixture
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test-support.ts",
    "src/**/__fixtures__"
  ]
}
