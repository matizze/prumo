{
  "name": "@matizze/prumo-cli",
  "version": "0.3.0",
  "description": "O comando prumo: new, make, add, promote, check e doctor.",
  "private": true,
  "type": "module",
  "bin": {
    "prumo": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "types": "./dist/index.d.ts",
    "bin": {
      "prumo": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@matizze/prumo-rules": "workspace:*",
    "citty": "^0.2.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
