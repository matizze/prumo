{
  "name": "prumo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run typecheck",
    "test": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run test",
    "verify:packages": "pnpm typecheck && pnpm test",
    "verify:reference": "pnpm --filter @matizze/prumo-reference run verify",
    "verify": "pnpm verify:packages && pnpm verify:reference",
    "dev": "pnpm --filter @matizze/prumo-reference run dev"
  }
}
