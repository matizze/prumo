{
  "name": "@matizze/prumo-rules",
  "version": "0.2.2",
  "description": "Regras da arquitetura do Prumo: plugin de ESLint, com aviso no editor, e análise do projeto inteiro para o prumo check.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matizze/prumo.git",
    "directory": "packages/rules"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./eslint": "./src/eslint/index.ts",
    "./check": "./src/check/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./eslint": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      },
      "./check": {
        "types": "./dist/check/index.d.ts",
        "default": "./dist/check/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^10.13.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
