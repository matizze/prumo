{
  "name": "@matizze/prumo-cli",
  "version": "0.6.0",
  "description": "O comando prumo: cria apps React organizados em camadas e confere a arquitetura.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matizze/prumo.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "prumo": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "types": "./dist/index.d.ts",
    "bin": {
      "prumo": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@matizze/prumo-rules": "workspace:*",
    "commander": "^15.1.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
