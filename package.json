{
  "name": "prumo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run typecheck",
    "lint": "eslint packages",
    "test": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "pnpm --filter \"./packages/*\" run build",
    "pack:all": "scripts/pack-packages.sh",
    "verify:new": "scripts/verify-new.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
