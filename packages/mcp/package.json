{
  "name": "@matizze/prumo-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP do Prumo: os comandos da CLI como ferramentas para agentes de IA.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matizze/prumo.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "prumo-mcp": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "bin": {
      "prumo-mcp": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.mjs dist",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@matizze/prumo-cli": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
